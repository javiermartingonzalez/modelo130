<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>

    <column>
        <name>codigo</name>
        <type>character varying(15)</type>
        <null>NO</null>
    </column>

    <column>
        <name>tipo</name>
        <type>character varying(20)</type>
        <null>NO</null>
    </column>

    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>

    <column>
        <name>nick</name>
        <type>character varying(50)</type>
    </column>

    <constraint>
        <name>mod130_conf_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>

    <constraint>
        <name>ca_mod130_conf_users_nick</name>
        <type>FOREIGN KEY (nick) REFERENCES users (nick) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>

    <constraint>
        <name>uniq_mod130_conf_codigo</name>
        <type>UNIQUE (codigo)</type>
    </constraint>
</table>
